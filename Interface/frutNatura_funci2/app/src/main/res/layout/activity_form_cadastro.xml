<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundfundo"
    tools:context=".form_cadastro">


    <TextView
        android:id="@+id/titulo_cadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/textpg2_cadastro"
        android:textColor="@color/white"
        android:textSize="50dp"
        android:textStyle="bold"
        android:layout_marginTop="100dp"
        app:layout_constraintBaseline_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <View
        android:id="@+id/conteiner_cadastro"
        style="@style/ContainerComponents"
        android:layout_width="359dp"
        android:layout_height="255dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo_cadastro"
        app:layout_constraintVertical_bias="0.13" />

    <EditText
        android:id="@+id/edit_nomecadastro"
        style="@style/Edit_Text"
        android:layout_marginBottom="15dp"
        android:drawableRight="@drawable/icone_person"
        android:hint="Nome"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="@+id/conteiner_cadastro"
        app:layout_constraintEnd_toEndOf="@+id/conteiner_cadastro"
        app:layout_constraintHorizontal_bias="0.464"
        app:layout_constraintStart_toStartOf="@+id/conteiner_cadastro"
        app:layout_constraintTop_toTopOf="@+id/conteiner_cadastro"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/edit_emailcadastro"
        style="@style/Edit_Text"
        android:hint="Email"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:drawableRight="@drawable/icone_email"
        android:inputType="textEmailAddress"
        app:layout_constraintBottom_toBottomOf="@+id/conteiner_cadastro"
        app:layout_constraintEnd_toEndOf="@+id/conteiner_cadastro"
        app:layout_constraintStart_toStartOf="@+id/conteiner_cadastro"
        app:layout_constraintTop_toBottomOf="@+id/edit_nomecadastro"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/edit_senhacadastro"
        style="@style/Edit_Text"
        android:layout_marginBottom="15dp"
        android:drawableRight="@drawable/icone_visibility_on"
        android:hint="Senha"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:inputType="textPassword"
        app:layout_constraintBottom_toBottomOf="@+id/conteiner_cadastro"
        app:layout_constraintEnd_toEndOf="@+id/conteiner_cadastro"
        app:layout_constraintStart_toStartOf="@+id/conteiner_cadastro"
        app:layout_constraintTop_toBottomOf="@+id/edit_emailcadastro"
        app:layout_constraintVertical_bias="0.076" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cadastrar"
        style="@style/Button"
        android:text="Cadastrar-se"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/conteiner_cadastro" />
</androidx.constraintlayout.widget.ConstraintLayout>