<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".inicio_chamado">

    <!-- 🔵 BARRA SUPERIOR -->
    <View
        android:id="@+id/barra_superior"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="@color/Verde"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/FrutNatura_suport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FrutNatura - Suporte"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@+id/barra_superior"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 🔵 BOTÕES DE AÇÃO -->
    <TextView
        android:id="@+id/NovoChamado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:drawableLeft="@drawable/icon_add"
        android:text="Novo chamado"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_btn_green"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/barra_superior"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"/>

    <ProgressBar
        android:id="@+id/progress_bar_chamados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/NovoChamado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:drawableLeft="@drawable/icon_chat"
        android:text="Chat"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_btn_green"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/barra_superior"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"/>

    <!-- 🔵 TÍTULO CHAMADOS -->
    <TextView
        android:id="@+id/chamados_recentes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chamados Recentes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/NovoChamado"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"/>

    <!-- 🔵 CONTAINER DOS CHAMADOS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/containerSuport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/chamados_recentes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/lista_chamados_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"/>
        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
