<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão para acessar a internet -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrutNatura_funci">

        <!-- Tela principal (Login) -->
        <activity
            android:name=".iniciar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de cadastro -->
        <activity
            android:name=".form_cadastro"
            android:exported="false" />

        <!-- TELA PRINCIPAL CORRETA DEPOIS DO LOGIN -->
        <activity
            android:name=".ecommerce"
            android:exported="false" />

        <!-- Outras telas do app -->
        <activity
            android:name=".tela_suporte"
            android:exported="true"/>
        <activity
            android:name=".inicio_chamado"
            android:exported="false" />
        <activity
            android:name=".chat_suport"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".FormLogin"
            android:exported="false" />

    </application>

</manifest>
