@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 15
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #666666
  ArrowColor #666666
}
title Diagrama de Casos de Uso — Administrador

actor "Administrador" as Admin

rectangle "Sistema de Suporte Técnico - FrutNatura" as Sistema {
  (Gerenciar Usuários) as UC_Usuarios
  (Gerenciar Configurações) as UC_Config
  (Gerar Relatórios) as UC_Relatorios
}

Admin --> UC_Usuarios
Admin --> UC_Config
Admin --> UC_Relatorios
@enduml
