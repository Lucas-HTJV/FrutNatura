	  <ProjectReference Include="..\Infrastructure\FrutNatura.Infra.Persistence\FrutNatura.Infra.Persistence.csproj" />
	  <ProjectReference Include="..\Infrastructure\FrutNatura.Infra.Realtime\FrutNatura.Infra.Realtime.csproj" />
	  <ProjectReference Include="..\Infrastructure\FrutNatura.Infra.Security\FrutNatura.Infra.Security.csproj" />
	  <ProjectReference Include="..\Infrastructure\FrutNatura.Infra\FrutNatura.Infra.csproj" />
