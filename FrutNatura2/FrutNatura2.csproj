	<ItemGroup>

	  <ProjectReference Include="..\Application\FrutNatura.App.Application\FrutNatura.App.Application.csproj" />
	  <ProjectReference Include="..\Core\FrutNatura.Core.Abstractions\FrutNatura.Core.Abstractions.csproj" />
